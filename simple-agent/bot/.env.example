# --- Telegram (получить на https://my.telegram.org -> API development tools) ---
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef

# --- Claude API (https://console.anthropic.com -> API Keys) ---
ANTHROPIC_API_KEY=sk-ant-...
# Модель для поиска обещаний. Дешевле в ~40 раз: claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5

# --- Настройки ---
TIMEZONE=Asia/Tashkent
# Во сколько присылать утренний дайджест (час, 0-23)
DIGEST_HOUR=9
# Сколько секунд ждать тишины в чате, прежде чем анализировать (чтобы видеть всю мысль)
DEBOUNCE_SECONDS=90
# Как часто напоминать о просроченном (часы)
OVERDUE_REPEAT_HOURS=4
# Чаты, которые НЕ анализировать: id или @username через запятую
EXCLUDE_CHATS=
# Анализировать и группы (true) или только личные переписки (false)
INCLUDE_GROUPS=true
